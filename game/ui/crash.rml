<rml>
<head>
    <title>Echoes of Time</title>
    <link type="text/rcss" href="menu.rcss"/>
    <link type="text/rcss" href="crash.rcss"/>
</head>
<body data-model="crash">
<div id="panel" class="crash" data-class-expanded="show_details">
    <div id="header">
        <div class="crystal"></div>
        <h1>Echoes of Time</h1>
        <div class="crystal"></div>
    </div>

    <h2>The game has crashed</h2>
    <p class="what">{{ what }}</p>
    <p class="note centered" data-if="!reported">A report was saved on this PC. Reporting the problem opens a new issue on GitHub with the details filled in, and a zip to attach with the full stack, your game settings (settings.ini) and the game's recent messages. It has no save data or game files; nothing is sent until you submit the issue.</p>
    <p class="note centered done" data-if="reported">{{ message }}</p>

    <div id="details" data-if="show_details">
        <p>{{ details }}</p>
    </div>

    <div id="footer">
        <span class="button nav" data-class-focused="focus == 0" data-event-click="restart">Restart game</span>
        <span class="button nav" data-class-focused="focus == 1" data-event-click="report">Report issue</span>
        <span class="button nav" data-class-focused="focus == 2" data-event-click="toggle_details">{{ show_details ? 'Hide details' : 'Show details' }}</span>
        <span class="button nav" data-class-focused="focus == 3" data-event-click="close">Close</span>
    </div>
    <p id="hint">Left/Right choose · Enter select · Esc close</p>
</div>
</body>
</rml>
