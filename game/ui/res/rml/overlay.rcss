body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    z-index: 2;
    pointer-events: none;
}

toast {
    position: absolute;
    border-width: 1dp;
    background-color: rgba(var(--color-surface-rgb), 80%);
}

toast {
    border-color: var(--toast-border-color);
    top: 40dp;
    right: 40dp;
    display: flex;
    flex-flow: column;
    border-radius: var(--radius-window);
    overflow: hidden;
    backdrop-filter: blur(5dp);
    box-shadow: 0 0 15dp 3dp;
    filter: opacity(0);
    transform: scale(0.9);
    transform-origin: center;
    transition: filter transform 0.2s cubic-in-out;
    padding: 18dp var(--space-xl);
    gap: var(--space-sm);
}

toast[open] {
    filter: opacity(1);
    transform: scale(1);
}

toast heading {
    display: flex;
    gap: 18dp;
    align-items: center;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: bold;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--toast-heading-color);
}

toast heading > toast-title {
    flex: 1 0 auto;
}

toast heading > row {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
}

toast message {
    display: flex;
    flex-flow: column;
    gap: var(--space-sm);
}

toast message row {
    display: flex;
}

toast message row.muted {
    opacity: 0.5;
}

toast.warning {
    --toast-border-color: var(--color-accent);
    --toast-heading-color: var(--color-accent);
}

toast.menu-notification {
    top: 40dp;
    right: auto;
    bottom: auto;
    left: 50%;
    max-width: 90%;
    transform: translateX(-50%) scale(0.9);
}

toast.menu-notification[open] {
    transform: translateX(-50%) scale(1);
}

toast.menu-notification message {
    align-items: center;
    text-align: center;
}

toast.menu-notification message row {
    align-items: center;
    gap: 6dp;
}

toast icon {
    width: 1.2em;
    height: 1.2em;
    font-size: 1.2em;
}

@media (max-height: 640dp) {
    toast {
        top: 20dp;
        right: 20dp;
    }

    toast.menu-notification {
        top: 20dp;
    }
}

/* The spell radial (see Overlay::update_spell_ring): placed by the code, grows into view while the right stick is pushed. */
.spell-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    filter: opacity(0);
    transform: scale(0.55);
    transition: filter transform 0.16s cubic-out;
    pointer-events: none;
}

.spell-ring[open] {
    filter: opacity(1);
    transform: scale(1);
}

.ring-backdrop {
    position: absolute;
    decorator: image(../ring-backdrop.png contain center center);
}

.ring-slot {
    position: absolute;
    transform: scale(1);
    transform-origin: center;
    transition: transform 0.1s cubic-out;
}

.ring-slot.selected {
    transform: scale(1.14);
}

.ring-holder {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
    decorator: image(../ring-holder.png contain center center);
}

.ring-slot.selected .ring-holder {
    decorator: image(../ring-holder-selected.png contain center center);
}

.ring-orb {
    position: absolute;
}

.ring-orb.element0 { decorator: image(../ring-orb0.png contain center center); }
.ring-orb.element1 { decorator: image(../ring-orb1.png contain center center); }
.ring-orb.element2 { decorator: image(../ring-orb2.png contain center center); }
.ring-orb.element3 { decorator: image(../ring-orb3.png contain center center); }
.ring-orb.element4 { decorator: image(../ring-orb4.png contain center center); }
.ring-orb.element5 { decorator: image(../ring-orb5.png contain center center); }
