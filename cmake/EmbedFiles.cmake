# Embeds files into a C++ source as byte arrays: a table of {path, data, size} named ui::kAssets.
#   cmake -D BASE_DIR=<dir> -D OUTPUT=<file.cpp> -D FILES="<a;b;...>" -P EmbedFiles.cmake
# Paths in the table are relative to BASE_DIR, with forward slashes.
set(out "// Generated by cmake/EmbedFiles.cmake from game/ui. Do not edit.\n#include \"ui_assets.hpp\"\n\nnamespace ui {\nnamespace {\n")
set(table "")
set(i 0)
foreach(f ${FILES})
  get_filename_component(ext "${f}" EXT)
  if(ext STREQUAL ".rml")
    # A markup file may include fragments: <!--#include name.rml--> is replaced by that file's text (from BASE_DIR), so
    # the settings menu and the setup wizard share the same rows.
    file(READ "${f}" text)
    while("${text}" MATCHES "<!--#include ([A-Za-z0-9_./-]+)-->")
      set(inc "${CMAKE_MATCH_1}")
      file(READ "${BASE_DIR}/${inc}" fragment)
      string(REPLACE "<!--#include ${inc}-->" "${fragment}" text "${text}")
    endwhile()
    string(HEX "${text}" hex)
  else()
    file(READ "${f}" hex HEX)
  endif()
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  # Break the initialiser into lines of 32 bytes.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" hex "${hex}")
  file(RELATIVE_PATH rel "${BASE_DIR}" "${f}")
  string(APPEND out "const unsigned char k${i}[] = {\n${hex}0};\n")
  string(APPEND table "    {\"${rel}\", k${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND out "}  // namespace\n\nconst Asset kAssets[] = {\n${table}};\nconst size_t kAssetCount = ${i};\n\n}  // namespace ui\n")
file(WRITE "${OUTPUT}" "${out}")
